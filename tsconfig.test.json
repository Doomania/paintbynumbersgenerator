{
  "compilerOptions": {
    "outDir": "build-test",
    "rootDir": "src",
    "noImplicitAny": true,
    "strict": true,
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "module": "commonjs",
    "target": "es2019",
    "lib": ["dom", "es2019"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/gui.ts", "src/guiprocessmanager.ts", "src/main.ts", "src/lib/clipboard.ts"]
}
